{
  "name": "MqttPurifier",
  "version": "1.0.0",
  "description": "Switch a Xiaomi air purifier on for ABS/ASA prints on a Bambu Lab printer, locally from an ESP32: Bambu MQTT in, Xiaomi miIO (AES-128 over UDP) out, non-blocking.",
  "keywords": "bambu, bambulab, mqtt, xiaomi, miio, miot, air purifier, fume extractor, 3d printing, esp32",
  "repository": {
    "type": "git",
    "url": "https://github.com/3dfarmers/mqtt_purifier.git"
  },
  "authors": [
    { "name": "3D Farmer GmbH", "url": "https://github.com/3dfarmers", "maintainer": true }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "MqttPurifier.h",
  "dependencies": [
    { "owner": "knolleary", "name": "PubSubClient", "version": "^2.8" }
  ],
  "examples": [
    { "name": "BambuPurifier", "base": "examples/BambuPurifier", "files": ["BambuPurifier.ino", "config.example.h"] },
    { "name": "PurifierBench", "base": "examples/PurifierBench", "files": ["PurifierBench.ino", "config.example.h"] }
  ],
  "export": {
    "exclude": ["tools", ".github"]
  }
}
